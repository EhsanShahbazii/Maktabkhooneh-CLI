# -------------------------------------------------------------
# Maktabkhooneh Authentication Configuration
# -------------------------------------------------------------
# Option 1: Provide full raw cookie string (copied from DevTools / cURL)
MAKTAB_COOKIE_STRING="analytics_token=...; csrftoken=...; sessionid=..."

# Option 2: Provide specific tokens
MAKTAB_SESSIONID=""
MAKTAB_CSRFTOKEN=""

# Option 3: Auto-extract from installed browser (chrome, brave, firefox, edge, safari, opera, chromium, vivaldi)
MAKTAB_BROWSER="chrome"

# -------------------------------------------------------------
# Concurrency & Performance Settings
# -------------------------------------------------------------
MAX_CONCURRENT_REQUESTS=8
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_MIN_DELAY_SECONDS=0.0
REQUEST_MAX_DELAY_SECONDS=0.05

# -------------------------------------------------------------
# Database & Storage
# -------------------------------------------------------------
DB_PATH="maktabkhooneh.db"
DOWNLOAD_DIR="downloads"
DEFAULT_QUALITY="1080p"

# -------------------------------------------------------------
# Telegram Integration & Host Storage Protection
# -------------------------------------------------------------
# Obtain from https://my.telegram.org
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="your_telegram_api_hash_here"

# Optional: Set Bot Token (for Bot mode) or leave empty for Userbot / Self-Bot mode
TELEGRAM_BOT_TOKEN=""

# Target channel, group, or chat (e.g. @my_courses_channel, -100123456789, or "me" for Saved Messages)
TELEGRAM_TARGET_CHAT="@my_courses_channel"

# Maximum temporary host disk storage threshold in Megabytes (e.g. 2048.0 = 2 GB)
STORAGE_LIMIT_MB="2048.0"
